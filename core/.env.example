# Copy this file to .env and fill values for production
# Keep this file out of source control (add .env to .gitignore)

# Secret key for Django
DJANGO_SECRET_KEY=replace-me-with-a-secure-random-string

# Debug mode: True/False
DJANGO_DEBUG=False

# Example SMS provider config (optional)
# Supported providers: twilio, vonage, africasTalking, telesonics
SMS_PROVIDER=twilio

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=+1234567890

# Teleconic Configuration (African SMS Provider)
# SMS_PROVIDER=teleconic
TELECONIC_API_KEY=TCSMS_vOBQ6rffzFJckZAAXGFExCtefKdT8eXwWMfGSJLl
TELECONIC_SENDER_ID=ALOHA
TELECONIC_API_URL=https://sms.teleconic.com/api/v1/send
