# Copy this file to .env and fill values for production
# Keep this file out of source control (add .env to .gitignore)

# Secret key for Django
DJANGO_SECRET_KEY=replace-me-with-a-secure-random-string

# Debug mode: True/False
DJANGO_DEBUG=False

# Example SMS provider config (optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=+1234567890
